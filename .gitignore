# Gradle (N4 module build)
.gradle/
**/build/

# Machine-specific Niagara paths (niagara_home, signing overrides)
gradle.properties.local
**/gradle.properties.local

# Eclipse / IDE build output
bin/
*.class
.settings/
.metadata/

# Niagara build/dist artifacts
*.jar.bak

# Code-signing profiles: the Tridium signing plugin rewrites them in place with a
# concrete storepass on build, so they must never be committed. CI generates the
# Windows-MY profile at runtime; local dev points signing.profile at a
# machine-local copy.
cert/safenet_signing_profile*.xml
cert/*.windows-my

# build-and-restart helper log
build-and-restart.log

# OS / editor cruft
Thumbs.db
.DS_Store
*~

# --- Secret hygiene: keep credentials out of git ---
# Local environment files (commit a .env.example with empty values instead)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
# Cloud credential files
credentials.json
service-account*.json
.aws/
